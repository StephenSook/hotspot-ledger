# Free Google AI Studio key from a project with NO billing account (Georgia 311 Challenge rule).
# Set it as a Vercel environment variable, never in the browser bundle.
GEMINI_API_KEY=

# Staff-only gate for /api/draft and /api/classify. A long random string (at least 32 characters;
# shorter values are refused), shared only with city staff. The web app sends it from the staff
# console in the x-staff-token header. Set it as a Vercel environment variable; never put it in a
# VITE_* variable, which would publish it in the browser bundle.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
STAFF_TOKEN=

# Ed25519 private key that signs printed notices (/api/sign), PKCS8 DER in base64. Server only.
# Its public half is NOTICE_PUBLIC_KEY in api/_lib/notice.ts; replace both together.
# Generate a pair with Node 22:
#   node -e "const {generateKeyPairSync:g}=require('crypto');const k=g('ed25519');console.log(k.privateKey.export({type:'pkcs8',format:'der'}).toString('base64'));console.log(k.publicKey.export({format:'jwk'}).x)"
NOTICE_SIGNING_KEY=
